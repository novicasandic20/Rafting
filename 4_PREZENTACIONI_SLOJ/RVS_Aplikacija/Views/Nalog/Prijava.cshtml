@model PrijavaNalogaViewModel

@{
    ViewData["Title"] = "Prijava";
}

<div class="auth-page">

    <div class="auth-card shadow-sm">

        <div class="auth-side">
            <div class="auth-side-content">

                <div class="auth-logo-wrapper">
                    <img src="~/images/rafting-logo.png"
                         alt="Rafting evidencija"
                         class="auth-logo" />
                </div>

                <h2>Dobro došli nazad</h2>

                <p>
                    Prijavite se kako biste pregledali svoje prijave,
                    učesnike i dokumentaciju.
                </p>

            </div>
        </div>

        <div class="auth-form-side">

            <div class="auth-form-content">

                <div class="mb-4">
                    <div class="auth-eyebrow">
                        Rafting evidencija
                    </div>

                    <h1 class="section-title mb-2">
                        Prijava korisnika
                    </h1>

                    <p class="text-muted mb-0">
                        Unesite podatke svog naloga.
                    </p>
                </div>

                <form asp-action="Prijava" method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <div class="input-group auth-input">

                            <span class="input-group-text">
                                <i class="bi bi-envelope"></i>
                            </span>

                            <input asp-for="Email"
                                   class="form-control"
                                   autocomplete="username"
                                   placeholder="Unesite email adresu" />

                        </div>

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-4">

                        <label asp-for="Lozinka"
                               class="form-label">
                        </label>

                        <div class="input-group auth-input">

                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>

                            <input asp-for="Lozinka"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Unesite lozinku" />

                        </div>

                        <span asp-validation-for="Lozinka"
                              class="text-danger">
                        </span>

                    </div>


                    <button class="btn btn-primary w-100 auth-submit"
                            type="submit">
                        Prijavi se
                    </button>

                </form>


                <div class="auth-switch">

                    <span>Nemate nalog?</span>

                    <a asp-controller="Nalog"
                       asp-action="Registracija">
                        Registrujte se
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}