@model NivoTezineViewModel
@{
    ViewData["Title"] = "Izmeni nivo težine";
}
<div class="card shadow-sm">
    <div class="card-body p-4">
        <h1 class="h3 section-title mb-4">Izmena nivoa težine preko REST servisa</h1>
        <form asp-action="Izmeni" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <partial name="_Forma" model="Model" />
            <button class="btn btn-primary" type="submit">Sačuvaj izmene</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
